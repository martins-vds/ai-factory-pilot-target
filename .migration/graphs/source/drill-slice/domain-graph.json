    {
      "id": "domain:specification-rules",
      "type": "domain",
      "name": "Specification Rules",
      "summary": "Reusable business-rule objects built on the Specification pattern; rules can be combined with and/or/not and are used to decide whether a cargo itinerary meets its route requirements.",
      "tags": [
        "specification",
        "ddd"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Specification",
          "AbstractSpecification",
          "AndSpecification",
          "OrSpecification",
          "NotSpecification"
        ],
        "businessRules": [
          "A composite specification is satisfied per the boolean combination of its wrapped specifications"
        ],
        "crossDomainInteractions": [
          "RouteSpecification (cargo-routing) extends AbstractSpecification"
        ]
      }
    },
    {
      "id": "domain:cargo-routing",
      "type": "domain",
      "name": "Cargo Routing",
      "summary": "Models a cargo shipment, its required route (origin, destination, deadline) and the itinerary of legs it is assigned to.",
      "tags": [
        "cargo",
        "routing"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Cargo",
          "RouteSpecification",
          "Itinerary",
          "Leg",
          "TrackingId",
          "Location"
        ],
        "businessRules": [
          "An itinerary satisfies a route spec only if origin, destination match and arrival is before the deadline",
          "Changing route or itinerary updates delivery synchronously"
        ],
        "crossDomainInteractions": [
          "Uses Specification Rules; consumes handling history from Cargo Handling"
        ]
      }
    },
    {
      "id": "domain:cargo-handling",
      "type": "domain",
      "name": "Cargo Handling and Delivery",
      "summary": "Tracks handling events (receive, load, unload, customs, claim) and derives the cargo delivery status from them.",
      "tags": [
        "handling",
        "delivery"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "HandlingEvent",
          "HandlingHistory",
          "Delivery"
        ],
        "businessRules": [
          "LOAD/UNLOAD events require a voyage; other events must not have one",
          "Transport status is derived from the last handling event"
        ],
        "crossDomainInteractions": [
          "Updates Cargo delivery; routing status uses RouteSpecification"
        ]
      }
    },
