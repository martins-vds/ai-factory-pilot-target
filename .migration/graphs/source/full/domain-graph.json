    {
      "id": "domain:cargo-booking",
      "type": "domain",
      "name": "Cargo Booking & Routing",
      "summary": "Lets booking agents register new cargo with an origin, destination and arrival deadline, request candidate itineraries and assign a route. Also handles changing destination and deadline.",
      "tags": [
        "booking",
        "routing",
        "cargo"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Cargo",
          "RouteSpecification",
          "Itinerary",
          "Leg",
          "TrackingId",
          "Location"
        ],
        "businessRules": [
          "Arrival deadline must be in the future",
          "Origin and destination must differ",
          "Itinerary must satisfy the route specification",
          "Changing destination/deadline invalidates the existing route"
        ],
        "crossDomainInteractions": [
          "Calls the Pathfinder service for routes",
          "Triggers delivery recalculation in Cargo Tracking"
        ]
      }
    },
    {
      "id": "domain:handling-events",
      "type": "domain",
      "name": "Handling Event Registration",
      "summary": "Receives reports of physical cargo handling (receive, load, unload, customs, claim) from file uploads, REST and mobile UI, and registers them asynchronously via JMS.",
      "tags": [
        "handling",
        "messaging",
        "events"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "HandlingEvent",
          "HandlingEventRegistrationAttempt",
          "Voyage",
          "HandlingHistory"
        ],
        "businessRules": [
          "Event must reference a known cargo, location and (if required) voyage",
          "Invalid events are rejected and logged",
          "Unparseable file lines are skipped and written to a failed file"
        ],
        "crossDomainInteractions": [
          "Registered events trigger cargo inspection in Cargo Tracking"
        ]
      }
    },
    {
      "id": "domain:cargo-tracking",
      "type": "domain",
      "name": "Cargo Tracking & Inspection",
      "summary": "Derives the delivery status of cargo from its handling history and itinerary, detects misdirection and arrival, and exposes status to customers and monitoring clients.",
      "tags": [
        "tracking",
        "delivery",
        "inspection"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Delivery",
          "HandlingHistory",
          "TransportStatus",
          "RoutingStatus",
          "HandlingActivity"
        ],
        "businessRules": [
          "Cargo is misdirected when last event is not on the itinerary",
          "Delivery state is recalculated after every handled event",
          "Unloading at the destination marks the cargo as arrived"
        ],
        "crossDomainInteractions": [
          "Consumes handling events from Handling Event Registration",
          "Uses itinerary from Cargo Booking & Routing"
        ]
      }
    },
