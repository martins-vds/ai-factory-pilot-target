  "nodes": [
    {
      "id": "domain:cargo-booking",
      "type": "domain",
      "name": "Cargo Booking & Routing",
      "summary": "Handles registration of new cargo, selection of an itinerary and later changes to destination or arrival deadline. Cargo is the aggregate root owning route specification and itinerary.",
      "tags": [
        "booking",
        "cargo",
        "routing",
        "aggregate"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Cargo",
          "RouteSpecification",
          "Itinerary",
          "Leg",
          "TrackingId",
          "Location",
          "UnLocode"
        ],
        "businessRules": [
          "Origin and destination of a route specification must differ",
          "A cargo's itinerary must satisfy its route specification",
          "Changing destination or deadline re-evaluates routing status"
        ],
        "crossDomainInteractions": [
          "Requests candidate routes from Pathfinder via the routing service",
          "Consumes handling progress from Handling & Tracking to update delivery"
        ]
      }
    },
    {
      "id": "domain:handling-tracking",
      "type": "domain",
      "name": "Handling & Delivery Tracking",
      "summary": "Registers handling events (receive, load, unload, customs, claim) reported by external parties and derives cargo delivery progress from the handling history. Detects misdirected and delivered cargo.",
      "tags": [
        "handling",
        "tracking",
        "delivery",
        "events"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "HandlingEvent",
          "HandlingHistory",
          "Delivery",
          "HandlingActivity",
          "TransportStatus",
          "RoutingStatus",
          "Voyage"
        ],
        "businessRules": [
          "Handling events must reference a known cargo, location and, where required, voyage",
          "Event deviating from the itinerary marks cargo misdirected",
          "Delivery is derived from the handling history"
        ],
        "crossDomainInteractions": [
          "Updates the Cargo aggregate of Cargo Booking",
          "Publishes cargo-handled, misdirected and delivered notifications via JMS"
        ]
      }
    },
    {
      "id": "domain:voyage-scheduling",
      "type": "domain",
      "name": "Voyage Scheduling & Pathfinding",
      "summary": "Models voyages with schedules of carrier movements and provides the pathfinder module that computes candidate transit paths between locations.",
      "tags": [
        "voyage",
        "schedule",
        "pathfinder",
        "routing"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Voyage",
          "Schedule",
          "CarrierMovement",
          "VoyageNumber",
          "TransitPath",
          "TransitEdge"
        ],
        "businessRules": [
          "Carrier movements in a voyage connect consecutively",
          "Transit paths are computed over the voyage graph within the deadline"
        ],
        "crossDomainInteractions": [
          "Supplies candidate itineraries to Cargo Booking",
          "Provides voyages referenced by handling events"
        ]
      }
    },
