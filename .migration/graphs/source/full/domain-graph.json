    {
      "id": "domain:cargo-booking",
      "type": "domain",
      "name": "Cargo Booking",
      "summary": "Lets shipping staff register new cargo with origin, destination and arrival deadline and amend those details afterwards. Owns the Cargo aggregate and its route specification.",
      "tags": [
        "booking",
        "cargo",
        "aggregate"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Cargo",
          "TrackingId",
          "RouteSpecification",
          "Location",
          "UnLocode"
        ],
        "businessRules": [
          "Every cargo gets a unique tracking id on booking",
          "Changing destination or deadline invalidates/re-evaluates routing status",
          "Arrival deadline must be a valid future date"
        ],
        "crossDomainInteractions": [
          "Requests candidate itineraries from Cargo Routing",
          "Receives delivery updates from Cargo Handling"
        ]
      }
    },
    {
      "id": "domain:cargo-routing",
      "type": "domain",
      "name": "Cargo Routing",
      "summary": "Finds candidate itineraries for a cargo's route specification via the external Pathfinder service and assigns the chosen itinerary to the cargo.",
      "tags": [
        "routing",
        "itinerary",
        "pathfinder"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Itinerary",
          "Leg",
          "Voyage",
          "Schedule",
          "CarrierMovement",
          "TransitPath"
        ],
        "businessRules": [
          "An itinerary must satisfy the route specification (origin, destination, deadline)",
          "Cargo is misrouted when handling deviates from its itinerary"
        ],
        "crossDomainInteractions": [
          "Called by Cargo Booking for route assignment",
          "Misdirection is detected by Cargo Handling"
        ]
      }
    },
    {
      "id": "domain:cargo-handling",
      "type": "domain",
      "name": "Cargo Handling",
      "summary": "Accepts handling reports (load, unload, receive, claim, customs) from REST, mobile and batch file channels, queues them via JMS and registers HandlingEvents.",
      "tags": [
        "handling",
        "events",
        "messaging",
        "batch"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "HandlingEvent",
          "HandlingHistory",
          "HandlingEventRegistrationAttempt",
          "Voyage"
        ],
        "businessRules": [
          "Event must reference a known cargo, location and (where needed) voyage",
          "Invalid registration attempts are rejected and reported"
        ],
        "crossDomainInteractions": [
          "Triggers Cargo Tracking inspection after each handled event",
          "Updates delivery state of Cargo"
        ]
      }
    },
    {
      "id": "domain:cargo-tracking",
      "type": "domain",
      "name": "Cargo Tracking",
      "summary": "Derives a cargo's delivery status from its handling history and exposes it to customers, plus notifies of delivered or misdirected cargo.",
      "tags": [
        "tracking",
        "delivery",
        "notifications"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Delivery",
          "HandlingActivity",
          "TransportStatus",
          "RoutingStatus",
          "CargoStatus"
        ],
        "businessRules": [
          "Delivery is recomputed from itinerary and handling history on every inspection",
          "Misdirected and delivered cargo trigger notifications"
        ],
        "crossDomainInteractions": [
          "Driven by events from Cargo Handling",
          "Reads cargo from Cargo Booking"
        ]
      }
