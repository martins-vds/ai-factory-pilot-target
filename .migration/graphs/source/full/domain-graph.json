    {
      "id": "domain:cargo-booking",
      "type": "domain",
      "name": "Cargo Booking & Routing",
      "summary": "Lets booking agents register new cargo, define its route specification, pick an itinerary from candidates and revise destination or arrival deadline. Cargo is the central aggregate.",
      "tags": [
        "booking",
        "routing",
        "aggregate"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Cargo",
          "RouteSpecification",
          "Itinerary",
          "Leg",
          "Location",
          "UnLocode",
          "TrackingId"
        ],
        "businessRules": [
          "Itinerary must satisfy the route specification (origin, destination, deadline)",
          "Changing destination or deadline invalidates the current routing status",
          "Locations are identified by valid 5-char UN/LOCODEs"
        ],
        "crossDomainInteractions": [
          "Asks Route Finding for candidate itineraries",
          "Re-derives delivery when handling events arrive"
        ]
      }
    },
    {
      "id": "domain:handling-events",
      "type": "domain",
      "name": "Handling Event Registration",
      "summary": "Accepts reports of physical cargo handling (receive, load, unload, customs, claim) via REST, mobile UI or batch file uploads, validates them asynchronously and records them.",
      "tags": [
        "handling",
        "messaging",
        "ingestion"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "HandlingEvent",
          "HandlingHistory",
          "HandlingEventRegistrationAttempt",
          "Voyage",
          "Carrier movement"
        ],
        "businessRules": [
          "Event must reference known cargo, location and voyage",
          "Invalid registration attempts are rejected and logged",
          "Registration is asynchronous via JMS queues"
        ],
        "crossDomainInteractions": [
          "Triggers Cargo Tracking inspection after an event is registered"
        ]
      }
    },
    {
      "id": "domain:cargo-tracking",
      "type": "domain",
      "name": "Cargo Tracking & Delivery",
      "summary": "Derives a cargo's delivery progress from its handling history, detects misdirection and arrival, notifies clients in real time and exposes public tracking.",
      "tags": [
        "tracking",
        "delivery",
        "notifications"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Delivery",
          "TransportStatus",
          "RoutingStatus",
          "HandlingActivity",
          "CargoStatus"
        ],
        "businessRules": [
          "Delivery is recalculated from latest handling event and itinerary",
          "Unexpected handling marks cargo misdirected",
          "Next expected activity follows the itinerary"
        ],
        "crossDomainInteractions": [
          "Consumes events from Handling Event Registration",
          "Reads itinerary from Cargo Booking"
        ]
      }
    },
    {
      "id": "domain:route-finding",
      "type": "domain",
      "name": "Route Finding (Pathfinder)",
      "summary": "Separate pathfinder application that returns candidate transit paths between locations, called remotely by the booking context through an anti-corruption routing service.",
      "tags": [
        "pathfinder",
        "routing",
        "rest"
      ],
      "complexity": "simple",
      "domainMeta": {
        "entities": [
          "TransitPath",
          "TransitEdge",
          "Voyage"
        ],
        "businessRules": [
          "Candidate paths are translated to domain itineraries by the routing service"
        ],
        "crossDomainInteractions": [
          "Serves Cargo Booking route requests"
        ]
      }
    },
