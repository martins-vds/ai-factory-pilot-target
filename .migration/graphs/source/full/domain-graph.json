    {
      "id": "domain:cargo-booking",
      "type": "domain",
      "name": "Cargo Booking & Routing",
      "summary": "Registers new cargo, assigns itineraries from the external pathfinder, and lets operators change destination or arrival deadline. Core of the shipping customer-facing back office.",
      "tags": [
        "booking",
        "routing"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Cargo",
          "RouteSpecification",
          "Itinerary",
          "Leg",
          "Location",
          "TrackingId"
        ],
        "businessRules": [
          "Itinerary must satisfy route specification",
          "Origin and destination must differ",
          "Arrival deadline must be in the future",
          "Changing route spec may misroute cargo"
        ],
        "crossDomainInteractions": [
          "Uses Pathfinder for candidate routes",
          "Delivery progress recalculated on route change"
        ]
      }
    },
    {
      "id": "domain:handling-reporting",
      "type": "domain",
      "name": "Handling Event Reporting",
      "summary": "Accepts handling reports (receive, load, unload, customs, claim) from mobile, REST and batch file channels and registers them asynchronously as handling events.",
      "tags": [
        "handling",
        "messaging"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "HandlingEvent",
          "HandlingEventRegistrationAttempt",
          "HandlingReport",
          "Voyage"
        ],
        "businessRules": [
          "Event must reference known cargo, voyage and location",
          "Invalid lines/reports are rejected, not lost"
        ],
        "crossDomainInteractions": [
          "Publishes cargo-handled messages consumed by tracking"
        ]
      }
    },
    {
      "id": "domain:cargo-tracking",
      "type": "domain",
      "name": "Cargo Tracking & Inspection",
      "summary": "Inspects cargo after each handling event, derives delivery status (transport, routing, ETA, next expected activity) and notifies of misdirection or delivery; exposes tracking to users.",
      "tags": [
        "tracking",
        "delivery"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Delivery",
          "HandlingHistory",
          "TransportStatus",
          "RoutingStatus"
        ],
        "businessRules": [
          "Event not matching itinerary means misdirected",
          "Unloading at final destination means delivered"
        ],
        "crossDomainInteractions": [
          "Consumes handling events; uses booking itinerary"
        ]
      }
    },
    {
