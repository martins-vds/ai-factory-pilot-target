          "RouteSpecification",
          "Itinerary",
          "Leg",
          "UnLocode"
        ],
        "businessRules": [
          "Origin and destination must differ",
          "An itinerary must satisfy the route specification (origin, destination, arrival deadline)",
          "Changing destination or deadline re-evaluates routing status"
        ],
        "crossDomainInteractions": [
          "Uses Routing and Scheduling to fetch candidate itineraries",
          "Handling events drive delivery progress of booked cargo"
        ]
      }
    },
    {
      "id": "domain:routing-scheduling",
