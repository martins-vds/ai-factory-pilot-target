      "id": "domain:cargo-tracking",
      "type": "domain",
      "name": "Cargo Tracking",
      "summary": "Lets customers look up a cargo by tracking ID and see its transport status, ETA, next expected activity, handling history and map position. Owns the Cargo aggregate with its route specification, itinerary and derived delivery state.",
      "tags": [
        "cargo",
        "tracking",
        "delivery"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Cargo",
          "TrackingId",
          "RouteSpecification",
          "Itinerary",
          "Leg",
          "Delivery",
          "HandlingActivity"
        ],
        "businessRules": [
          "TrackingId must be a validated non-empty identifier",
          "Delivery is derived from route spec, itinerary and last handling event",
          "Itinerary decides whether a handling event matches the planned route",
          "Route is satisfied only if itinerary meets origin, destination and deadline"
        ],
        "crossDomainInteractions": [
          "Reads handling history from Handling",
          "References Location and Voyage in legs"
        ]
      }
    },
    {
      "id": "domain:handling",
      "type": "domain",
      "name": "Cargo Handling",
      "summary": "Records handling events (load, unload, receive, claim, etc.) that happen to cargo and exposes them as a time-ordered handling history used to derive delivery status.",
      "tags": [
        "handling",
        "events"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "HandlingEvent",
          "HandlingEventType",
          "HandlingHistory"
        ],
        "businessRules": [
          "Handling events are immutable",
          "History is ordered by time"
        ],
        "crossDomainInteractions": [
          "Feeds Cargo Tracking delivery derivation",
          "Events refer to locations and voyages"
        ]
      }
    },
