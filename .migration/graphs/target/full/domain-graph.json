      "id": "domain:cargo-tracking",
      "type": "domain",
      "name": "Cargo Tracking",
      "summary": "Lets customers look up a cargo by tracking ID and see its status, ETA, handling history, next expected activity and map position. Owns the Cargo aggregate and derived Delivery state.",
