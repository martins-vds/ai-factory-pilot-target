      "id": "domain:cargo-tracking",
      "type": "domain",
      "name": "Cargo Tracking",
      "summary": "Lets a customer enter a tracking ID and see a cargo's status, ETA, next expected activity, handling history and map position. Cargo aggregates carry route specification, itinerary and derived delivery state.",
      "tags": [
        "cargo",
        "tracking"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Cargo",
          "TrackingId",
          "RouteSpecification",
          "Itinerary",
          "Leg",
          "Delivery",
          "HandlingActivity"
        ],
        "businessRules": [
          "A cargo is identified by its tracking ID",
          "Route must satisfy origin, destination and arrival deadline",
          "Delivery derives routing status, transport status and misdirection from itinerary and handling history"
        ],
        "crossDomainInteractions": [
          "Reads handling history from Handling",
          "References Locations and Voyages in itinerary legs"
        ]
      }
    },
    {
      "id": "domain:handling",
      "type": "domain",
      "name": "Cargo Handling",
      "summary": "Records handling events (load, unload, receive, claim, customs) reported for cargos and exposes an ordered, de-duplicated history that drives delivery status.",
      "tags": [
        "handling",
        "events"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "HandlingEvent",
          "HandlingHistory",
          "HandlingEventType"
        ],
        "businessRules": [
          "Event types are validated and times normalized",
          "History is time-ordered and de-duplicated",
          "Most recent event determines last known state"
        ],
        "crossDomainInteractions": [
          "Supplies history to Cargo Tracking"
        ]
      }
    },
