  "nodes": [
    {
      "id": "domain:cargo-tracking",
      "type": "domain",
      "name": "Cargo Tracking",
      "summary": "Lets users look up a cargo by tracking ID and see its delivery status, ETA, next expected activity, handling history and map position. Owns the Cargo aggregate, route specification, itinerary and derived Delivery.",
      "tags": [
        "cargo",
        "tracking",
        "delivery"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Cargo",
          "TrackingId",
          "RouteSpecification",
          "Itinerary",
          "Leg",
          "Delivery",
          "HandlingActivity"
        ],
        "businessRules": [
          "A cargo is identified by its tracking ID",
          "An itinerary satisfies a route specification only if origin, destination and deadline match",
          "Delivery progress, ETA and next expected activity are derived from the latest handling event",
          "All datetimes are normalized to UTC"
        ],
        "crossDomainInteractions": [
          "Reads handling history from Handling Registration",
          "Resolves locations and voyages from Reference Data"
        ]
      }
    },
    {
      "id": "domain:handling-registration",
      "type": "domain",
      "name": "Handling Registration",
      "summary": "Accepts handling reports (receive, load, unload, claim, customs) and asynchronously turns them into handling events that update a cargo's delivery. Manages the lifecycle of queued registration attempts with retry and rejection.",
      "tags": [
        "handling",
        "events",
        "queue"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "HandlingEvent",
          "HandlingHistory",
          "RegistrationAttempt"
        ],
        "businessRules": [
          "A voyage is required for load and unload events",
          "Attempts are atomically claimed before processing",
          "Attempts end as registered or rejected, and rejections carry a reason",
          "Transient failures are retried; permanent failures are rejected"
        ],
        "crossDomainInteractions": [
          "Updates Cargo delivery after registering events",
          "Resolves locations and voyages from Reference Data"
        ]
      }
    },
    {
      "id": "domain:reference-data",
      "type": "domain",
      "name": "Reference Data",
      "summary": "Master data for locations (UN/LOCODE) and voyages (voyage number with carrier movement schedule). Also provides sample data seeding for demos.",
      "tags": [
        "location",
        "voyage",
        "master-data"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Location",
          "UnLocode",
          "Voyage",
          "VoyageNumber",
          "Schedule",
          "CarrierMovement"
        ],
        "businessRules": [
          "Locations are keyed by a valid UN/LOCODE",
          "Voyage numbers are validated",
          "Carrier movements chain from departure to arrival location"
        ],
        "crossDomainInteractions": [
          "Referenced by cargos' routes and itineraries",
          "Referenced when resolving handling attempts"
        ]
      }
    },
