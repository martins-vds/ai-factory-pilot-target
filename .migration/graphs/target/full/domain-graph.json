        "entities": [
          "HandlingEvent",
          "HandlingEventType",
          "HandlingHistory"
        ],
        "businessRules": [
          "Load/unload events require a voyage",
          "History is sorted by completion time with unique events"
        ],
        "crossDomainInteractions": [
          "Feeds last event into Cargo Delivery calculation"
        ]
      }
    },
