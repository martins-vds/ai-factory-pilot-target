        "cargo",
        "tracking",
        "delivery"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Cargo",
          "TrackingId",
          "Delivery",
          "RouteSpecification",
          "Itinerary",
          "Leg",
          "HandlingActivity"
        ],
        "businessRules": [
          "Routing status derives from itinerary vs. route specification",
          "Cargo is misdirected when last handling event does not match itinerary",
          "ETA hidden for claimed cargo"
        ],
        "crossDomainInteractions": [
          "Reads handling history from Handling Events",
          "References Locations and Voyages in legs and route spec"
        ]
      }
    },
    {
      "id": "domain:handling-events",
