    {
      "id": "domain:cargo-tracking",
      "type": "domain",
      "name": "Cargo Tracking",
      "summary": "Lets customers look up a cargo by tracking ID and see its status, route, ETA, next expected activity, handling history and map position. Owns the Cargo aggregate and its derived Delivery state.",
      "tags": [
        "cargo",
        "tracking",
        "delivery"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Cargo",
          "TrackingId",
          "RouteSpecification",
          "Itinerary",
          "Leg",
          "Delivery",
          "HandlingActivity"
        ],
        "businessRules": [
          "Tracking ID must be valid",
          "Delivery is derived from route spec, itinerary and last handling event",
          "Handling events must match itinerary to be expected"
        ],
        "crossDomainInteractions": [
          "Reads handling history from Handling",
          "Resolves locations via Location"
        ]
      }
    },
    {
      "id": "domain:handling-registration",
      "type": "domain",
      "name": "Handling Registration",
      "summary": "Accepts reports of cargo handling events (receive, load, unload, claim, customs), queues them as registration attempts and processes them asynchronously into handling events with retry on temporary failures.",
      "tags": [
        "handling",
        "events",
        "queue"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "HandlingEvent",
          "HandlingEventType",
          "HandlingHistory",
          "RegistrationAttempt"
        ],
        "businessRules": [
          "Load/unload events require a voyage",
          "Unknown cargo, location or voyage is a permanent failure",
          "Temporary failures are retried"
        ],
        "crossDomainInteractions": [
          "Resolves Cargo, Location and Voyage references",
          "Updates Cargo delivery after events"
        ]
      }
    },
    {
      "id": "domain:location-management",
      "type": "domain",
      "name": "Location Management",
      "summary": "Maintains ports and places identified by UN/LOCODE, used as origins, destinations and handling sites.",
      "tags": [
        "location",
        "unlocode"
      ],
      "complexity": "simple",
      "domainMeta": {
        "entities": [
          "Location",
          "UnLocode"
        ],
        "businessRules": [
          "UN/LOCODE must match the required format"
        ],
        "crossDomainInteractions": [
          "Supplies locations to Cargo, Handling and Voyage"
        ]
      }
    },
