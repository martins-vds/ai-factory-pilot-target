          "Changing destination or deadline re-derives delivery status",
          "Itinerary must satisfy the route specification"
        ],
        "crossDomainInteractions": [
          "Requests candidate routes from Route Finding",
          "Booked cargo is tracked by Cargo Tracking"
        ]
      }
    },
    {
      "id": "domain:cargo-tracking",
      "type": "domain",
