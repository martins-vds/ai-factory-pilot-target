        "handling-tracking"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "HandlingEvent",
          "RegistrationAttempt",
          "HandlingHistory",
          "Delivery"
        ],
        "businessRules": [
          "Handling events are deduplicated and ordered chronologically",
          "Delivery status is derived from the itinerary and handling history"
        ],
        "crossDomainInteractions": [
          "Updates Cargo delivery from handling events",
          "Resolves Location and Voyage references"
        ]
      }
    },
