        "cargo-booking"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Cargo",
          "RouteSpecification",
          "Itinerary",
          "Leg",
          "TrackingId"
        ],
        "businessRules": [
          "A route specification needs an origin, destination and arrival deadline",
          "An itinerary must satisfy the route specification to be assigned"
        ],
        "crossDomainInteractions": [
          "Requests candidate routes from Pathfinder",
          "Reads handling-derived delivery status from Handling & Tracking"
        ]
      }
    },
    {
      "id": "domain:handling-tracking",
      "type": "domain",
      "name": "Handling & Tracking",
